# ---- Ishchi bot ----
# @BotFather dan olingan YANGI bot tokeni (taksi botiniki EMAS)
STAFF_BOT_TOKEN=

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Ruxsat (MAJBURIY) ----
# Kim ishlata oladi. Bu bot pul sarflaydi.
# O'z ID ingiz: botga /id yozing
ALLOWED_USERS=1002126405965

# Qaysi guruhda ishlaydi. Guruhda /id yozib bilib oling.
# Guruh ID manfiy bo'ladi: -1001234567890
# Bo'sh qoldirsangiz - hamma joyda (lekin faqat ALLOWED_USERS uchun)
ALLOWED_CHATS=

# ---- Baza ----
DATABASE_URL=sqlite+aiosqlite:///zarstaff.db

# Taksi botining bazasi - FAQAT O'QISH uchun.
# Railway'da Postgres.DATABASE_URL dan nusxalang.
TAXI_DATABASE_URL=

# ---- Cheklovlar ----
# Kunlik xarajat chegarasi (USD). Ehtiyot uchun past qo'ying.
DAILY_LIMIT_USD=5.0

# Nechta oxirgi xabar agentga kontekst sifatida beriladi
MEMORY_MESSAGES=25

# ---- Vaqt ----
# Mahalliy vaqt siljishi. Kunlik limit va hisobot shu bo'yicha.
# O'zbekiston = 5. Bo'sh qoldirsangiz ham 5.
TZ_OFFSET_HOURS=5

# ---- Avtomatik kunlik hisobot ----
# Qaysi soatda guruhga statistika yuborilsin (0-23, mahalliy vaqt).
# Bo'sh yoki manfiy - o'chirilgan. AI ishlatilmaydi, pul ketmaydi.
REPORT_HOUR=

# Qaysi chatga. Bo'sh bo'lsa ALLOWED_CHATS dagi birinchisi.
REPORT_CHAT_ID=

# ---- Ovozli xabar (ixtiyoriy) ----
# Claude audio tushunmaydi, shuning uchun ovoz avval matnga
# o'giriladi. Whisper bilan mos keladigan har qanday xizmat bo'ladi.
# Bo'sh qoldirsangiz ovozli xabar e'tiborsiz qoladi.
VOICE_API_URL=
VOICE_API_KEY=
VOICE_MODEL=whisper-1

# ---- Interfeys ----
# Javob yozilishi bilan ko'rsatilsinmi. O'chirish uchun 0.
STREAM=1
